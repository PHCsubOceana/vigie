[Unit]
Description=Vigie - cerveau de supervision des agents
After=network-online.target mosquitto.service ollama.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/vigie.env
ExecStart=/usr/bin/python3 __DIR__/vigie.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
